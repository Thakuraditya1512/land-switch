{
  "expo": {
    "name": "switchLAND.IN",
    "slug": "switchland-in",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "imageWidth": 180,
      "backgroundColor": "#F4F2ED"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.plotinvest.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#153D36"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow switchLAND.IN to select property photos.",
          "cameraPermission": "Allow switchLAND.IN to take property photos."
        }
      ]
    ]
  }
}
